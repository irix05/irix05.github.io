      "title": "Cohesion / Trust",
      "scale": { "domain": [0, 100] },
      "axis": { "labelColor": "#c0c0c0", "titleColor": "#e0e0e0", "domainColor": "rgba(255,255,255,0.06)", "gridColor": "rgba(255,255,255,0.06)" }
    },
    "color": { "field": "metric", "type": "nominal", "scale": { "range": ["#264653", "#e76f51"] } }
  }
}