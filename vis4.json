{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "The Fracture",
  "data": {
    "values": [
      { "side": "Us", "cohesion": 80 },
      { "side": "Them", "cohesion": 75 },
      { "side": "Middle", "cohesion": 25 },
      { "side": "Us", "trust": 60 },
      { "side": "Them", "trust": 45 },
      { "side": "Middle", "trust": 30 }
    ]
  },
